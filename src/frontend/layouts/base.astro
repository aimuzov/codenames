---
import '@fontsource-variable/manrope'
import '@aimuzov/infra-site-kit/base.css'
import '@aimuzov/infra-site-kit/ui/tokens.css'
import '#frontend/styles/global.css'
import { site } from '#frontend/data/site.ts'
import { pageTitle } from '#frontend/lib/title.ts'

type Props = {
	/** Название страницы, к нему добавится название сайта. У главной не задаётся. */
	title?: string
	/** `meta description` и `og:description`, по умолчанию `site.description`. */
	description?: string
	/** `false` у служебных страниц вроде 404: без canonical и с запретом индексации. */
	index?: boolean
}

const { title, description = site.description, index = true } = Astro.props
const fullTitle = pageTitle(title)
const canonical = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1, user-scalable=no"
		/>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		{index ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta name="theme-color" content="#0f172a" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="apple-mobile-web-app-title" content={site.name} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<!-- Блокирующий намеренно: тема должна выставиться до первой отрисовки. -->
		<script is:inline src="/theme.js"></script>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>
