{
	"name": "codenames",
	"type": "module",
	"version": "1.7.0",
	"license": "MIT",
	"private": true,
	"engines": {
		"node": "26.11.1"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"relay": "node --watch src/backend/server.ts",
		"check": "astro check && svelte-check",
		"test": "node --test 'src/**/*.test.ts'",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"astro": "astro",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint:css": "stylelint \"src/**/*.{css,astro,svelte}\"",
		"lint:js": "oxlint --deny-warnings",
		"lint:fix": "oxlint --fix",
		"prepare": "husky",
		"commit": "cz"
	},
	"dependencies": {
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@aimuzov/infra-site-kit": "github:aimuzov/infra-site-kit#v5.8.1",
		"@astrojs/check": "0.9.10",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@commitlint/cli": "21.0.2",
		"@commitlint/config-conventional": "21.0.2",
		"@csstools/postcss-global-data": "4.0.0",
		"@fontsource-variable/manrope": "5.3.0",
		"@lucide/svelte": "1.55.0",
		"@playwright/test": "1.64.0",
		"@types/node": "26.6.5",
		"@types/pako": "2.0.4",
		"@types/qrcode": "1.5.6",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-basic-ssl": "2.3.0",
		"@zxing/browser": "0.2.0",
		"@zxing/library": "0.22.0",
		"astro": "7.3.7",
		"commitizen": "4.3.2",
		"conventional-commits-filter": "5.0.0",
		"cz-git": "1.13.1",
		"husky": "9.1.7",
		"idb-keyval": "6.2.5",
		"oxlint": "1.87.0",
		"pako": "2.1.0",
		"postcss-custom-media": "12.0.3",
		"postcss-nested": "8.0.1",
		"prettier": "3.9.9",
		"qrcode": "1.5.4",
		"stylelint": "17.16.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"typescript": "6.0.3",
		"workbox-build": "7.4.1"
	},
	"imports": {
		"#frontend/*": "./src/frontend/*",
		"#backend/*": "./src/backend/*",
		"#shared/*": "./src/shared/*"
	},
	"config": {
		"commitizen": {
			"path": "node_modules/cz-git"
		}
	}
}
