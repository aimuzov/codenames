# Переменные сборки. Файл нужен даже пустым: compose передаёт его в Dockerfile секретом.

# Voice chat TURN, read at runtime by the relay and coturn (deploy/docker-compose.yml).
# Without them the relay hands out STUN only, enough on one network and in e2e.
# TURN_SECRET=<openssl rand -hex 32>
# TURN_URLS=turn:codenames.aimuzov.online:3478?transport=udp,turn:codenames.aimuzov.online:3478?transport=tcp
